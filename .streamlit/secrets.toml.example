# Copy this file to .streamlit/secrets.toml and fill in your values.
# On Streamlit Cloud, paste these key=value pairs into the Secrets panel
# (Settings → Secrets) — do NOT commit the actual secrets.toml to git.

OPENAI_API_KEY = "sk-..."

SNOW_URL  = "https://dev218436.service-now.com"
SNOW_USER = "admin"
SNOW_PASS = "your-servicenow-password"

# ── AWS IAM Role (AssumeRole) ────────────────────────────────────────────────
# The app authenticates via STS AssumeRole — no long-lived credentials are used
# for actual AWS operations. All real API calls use short-lived role credentials.

# Role to assume for all AWS operations (read-only scan permissions)
AWS_ROLE_ARN = "arn:aws:iam::448549863273:role/CISCloudShieldRole"

# Bootstrap user: CISCloudShieldBootstrap
# Has ONLY sts:AssumeRole permission on CISCloudShieldRole.
# Required on Streamlit Cloud (no instance profile available).
# Get these values from the Infosys platform team — do NOT commit real keys here.
AWS_ACCESS_KEY_ID     = "AKIA...your-bootstrap-key..."
AWS_SECRET_ACCESS_KEY = "your-bootstrap-secret..."

# Optional — defaults to us-east-1
AWS_DEFAULT_REGION = "us-east-1"
